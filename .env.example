# Copy to .env on your machine only — never commit.
# Prefer Grok Bot vault / connect cards over .env when using the bot.

# Configure only the transcription provider selected during setup.
# XAI_API_KEY=          # Grok Voice Transcribe 2.0 (recommended)
# ELEVENLABS_API_KEY=   # only if ElevenLabs Scribe is selected and its connection requires a key
# SCRAPECREATORS_API_KEY=  # if not using the MCP vault card
